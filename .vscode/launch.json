  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'bore'",
      "cargo": {
        "args": ["build", "--bin=bore", "--package=bore-cli"],
        "filter": {
          "name": "bore",
          "kind": "bin"
        }
      },
      "args": ["local", "--to=127.0.0.1", "--port=2345", "8000"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
